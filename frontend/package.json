{
  "name": "hand-gesture-recognition-frontend",
  "version": "1.0.0",
  "description": "Frontend for hand gesture recognition web app",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules node_modules/jest/bin/jest.js --no-coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules node_modules/jest/bin/jest.js --watch --no-coverage",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "echo 'No type checking configured yet'"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/js/$1"
    },
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/**/*.test.js"
    ]
  }
}
